  <!-- JAVASCRIPT INTERAKTIF -->
  <script>
    // 1. Efek Ketik Otomatis (Typing Animation)
    const texts = [
      "Teknik Komputer & Jaringan (TKJ)",
      "Network & Server Enthusiast",
      "MikroTik, Cisco & Linux Explorer",
      "IT Support & Cyber Security Learner"
    ];
    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typingEl = document.getElementById("typingText");

    function typeEffect() {
      const currentText = texts[textIndex];
      if (isDeleting) {
        typingEl.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
      } else {
        typingEl.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
      }

      let delay = isDeleting ? 40 : 80;
      if (!isDeleting && charIndex === currentText.length) {
        delay = 1800;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
        delay = 350;
      }
      setTimeout(typeEffect, delay);
    }
    typeEffect();

    // 2. Fitur Upload & Preview Foto Profil Langsung
    const uploadPhoto = document.getElementById("uploadPhoto");
    const profileImage = document.getElementById("profileImage");

    uploadPhoto.addEventListener("change", function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
          profileImage.src = event.target.result;
          showToast("Foto profil Cahyadi berhasil diperbarui!");
        };
        reader.readAsDataURL(file);
      }
    });

    // 3. Fungsi Salin Email & Nomor Telepon
    function copyText(value, label) {
      navigator.clipboard.writeText(value).then(() => {
        showToast(`${label} (${value}) berhasil disalin!`);
      });
    }

    function showToast(msg) {
      const toast = document.getElementById("toast");
      const toastMsg = document.getElementById("toastMsg");
      toastMsg.textContent = msg;
      toast.classList.remove("translate-y-24", "opacity-0");
      setTimeout(() => {
        toast.classList.add("translate-y-24", "opacity-0");
      }, 3000);
    }

    // 4. Animasi Partikel Jaringan Komputer (Network Canvas)
    const canvas = document.getElementById("networkCanvas");
    const ctx = canvas.getContext("2d");
    let nodes = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener("resize", resize);
    resize();

    const palette = ["#22d3ee", "#a855f7", "#ec4899", "#fbbf24"];
    class Node {
      constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.65;
        this.vy = (Math.random() - 0.5) * 0.65;
        this.r = Math.random() * 2.2 + 1;
        this.color = palette[Math.floor(Math.random() * palette.length)];
      }
      move() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
      }
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.fill();
      }
    }

    for (let i = 0; i < 60; i++) nodes.push(new Node());

    function renderNetwork() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].move();
        nodes[i].draw();
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < 135) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(56, 189, 248, ${(1 - distance / 135) * 0.45})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(renderNetwork);
    }
    renderNetwork();
  </script>
